# ========================================================
# App Configuration
# ========================================================
APP_URL=https://dj.app

# ========================================================
# Supabase Configuration
# ========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-legacy-jwt-secret
# Or if using asymmetric ES256: SUPABASE_JWT_PRIVATE_JWK='{"kty":"EC","crv":"P-256",...}'
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-...pooler.supabase.com:6543/postgres

# ========================================================
# Auth.js (NextAuth v5) Configuration
# ========================================================
AUTH_SECRET=your-32-byte-base64-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Apple Sign In (Optional / Enabled via flag)
NEXT_PUBLIC_APPLE_ENABLED=false
AUTH_APPLE_ID=your-apple-service-id
AUTH_APPLE_SECRET=your-apple-client-secret-jwt

# ========================================================
# Email & Magic Link (Resend)
# ========================================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Dating Journal <noreply@dj.app>

# ========================================================
# Background Cron
# ========================================================
CRON_SECRET=your-cron-secret-key

# ========================================================
# Web Push Notifications (VAPID)
# ========================================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@dj.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ========================================================
# Maps & Geocoding (Optional)
# ========================================================
GOONG_API_KEY=your-goong-api-key

# ========================================================
# AI Services (Google Gemini)
# ========================================================
GEMINI_API_KEY=your-gemini-api-key
